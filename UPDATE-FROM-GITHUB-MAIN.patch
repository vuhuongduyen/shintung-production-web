@@ -0,0 +1,9 @@
+'use client';
+import {useState} from 'react';
+import {productionApiFetch as fetch} from '../lib/production-api';
+import {FeedbackActionButton as Button} from './action-feedback';
+export default function ProductionReportingDayCancel({refresh}:{refresh:()=>void}){
+ const [preview,setPreview]=useState<any>(null),[busy,setBusy]=useState(false),[message,setMessage]=useState('');
+ const run=async(action:string)=>{if(busy)return;setBusy(true);setMessage('');try{const response=await fetch('/api/production-correction',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({operation:'cancel-reporting-day',action,expectedRevision:preview?.expectedRevision})});const result=await response.json();if(!response.ok)throw Error(result.error||'Không thể xử lý.');setPreview(action==='preview'?result:null);if(action==='apply'){setMessage(`Đã hủy ${result.reportCount} báo công và ${result.eventCount} thao tác của ${result.orders.length} lệnh. Đã lưu lịch sử; giữ nguyên dữ liệu ERP.`);refresh();}}catch(e){setMessage((e as Error).message);}finally{setBusy(false);}};
+ return <section className="data-card"><h3>Đối chiếu báo công thao tác ngày 27/10/2026</h3><p>Theo thời gian ghi nhận trên web (GMT+7), kể cả khai báo lùi ngày; không chọn dữ liệu nhập ERP. Hủy mềm cả thao tác nhập/xuất trạm liên quan, giữ lịch sử.</p><Button disabled={busy} onClick={()=>void run('preview')}>Kiểm tra báo công 27/10/2026</Button>{preview&&<><p>{preview.reportCount} báo công · {preview.eventCount} thao tác · {preview.orders.length} lệnh</p><table><thead><tr>{['LSX','SKU','Line','Thao tác','Báo công','SL thành phẩm'].map(h=><th key={h}>{h}</th>)}</tr></thead><tbody>{preview.orders.map((o:any)=><tr key={o.id}><td>{o.lsx}</td><td>{o.sku}</td><td>{o.line}</td><td>{o.events}</td><td>{o.reports}</td><td>{o.quantity}</td></tr>)}</tbody></table>{preview.blockers.map((s:string)=><p key={s} role="alert">{s}</p>)}<Button disabled={busy||!preview.eventCount||preview.blockers.length>0} onClick={()=>void run('apply')}>Hủy các báo công đã kiểm tra</Button></>}{message&&<p role="status">{message}</p>}</section>;
+}
diff --git a/lib/production-reporting-hold.mjs b/lib/production-reporting-hold.mjs
new file mode 100644
--- /dev/null
+++ b/lib/production-reporting-hold.mjs
@@ -0,0 +1,11 @@
+// Temporary production-only hold requested while ERP data is being imported.
+export const reportingHoldEndsAt='2026-11-01T00:00:00+07:00';
+export function productionReportingHold(hostname,now=Date.now()) {
+ const active=hostname==='main.example.invalid'&&Number(now)>=Date.parse('2026-10-27T00:00:00+07:00')&&Number(now)<Date.parse(reportingHoldEndsAt);
+ return active?{active:true,endsAt:reportingHoldEndsAt,remainingMs:Date.parse(reportingHoldEndsAt)-Number(now),message:'Tạm khóa báo công trên web chính đến hết 31/10/2026 để nhập dữ liệu ERP. Tự mở lại lúc 00:00 ngày 01/11/2026 (GMT+7).'}:null;
+}
+export function reportingWriteBlocked(path,body={}) {
+ if(path==='/api/production-report')return true;
+ if(path!=='/api/production-workflow')return false;
+ return !!body.stageEntries||['start','complete','pause','resume','transfer','add','reduce','extra','incident','incident-create'].includes(body.action);
+}
